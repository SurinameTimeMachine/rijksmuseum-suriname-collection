      "prefLabel": "Gezicht op de molen en het kookhuis van plantage Waterland in Suriname",
      "P2_has_type": "https://data.suriname-timemachine.org/type/source-type/visual-record",
      "P4_has_time_span": "https://data.suriname-timemachine.org/timespan/1708",
      "timeSpan": "1708",
      "maker": "Valkenburg, Dirk",
      "holdingArchive": "Rijksmuseum, Amsterdam",
