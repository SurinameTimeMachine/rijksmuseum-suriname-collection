      "P4_has_time_span": "https://data.suriname-timemachine.org/timespan/1927",
      "timeSpan": "1927",
      "maker": "Guilonard, familie, anoniem",
      "holdingArchive": "Rijksmuseum, Amsterdam",
      "handleUrl": "https://www.rijksmuseum.nl/nl/collectie/NG-2008-48",
      "sameAs": "https://id.rijksmuseum.nl/200497896",
