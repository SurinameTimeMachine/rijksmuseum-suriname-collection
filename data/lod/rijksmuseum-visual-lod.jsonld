    {
      "@id": "https://data.suriname-timemachine.org/source/rijksmuseum-sk-a-4087",
      "@type": [
        "E22_Human_Made_Object"
      ],
      "sourceId": "rijksmuseum-sk-a-4087",
      "prefLabel": "Gezicht op de koffieplantage Marienbosch in Suriname",
      "P2_has_type": "https://data.suriname-timemachine.org/type/source-type/visual-record",
      "P4_has_time_span": "https://data.suriname-timemachine.org/timespan/1829",
      "timeSpan": "1829",
      "maker": "Klerk, Willem de, Brockmann, Alexander Ludwich",
      "holdingArchive": "Rijksmuseum, Amsterdam",
      "handleUrl": "https://www.rijksmuseum.nl/nl/collectie/SK-A-4087",
      "sameAs": "https://id.rijksmuseum.nl/200111810",
      "rijksmuseumDataUrl": "https://data.rijksmuseum.nl/200111810",
      "rijksmuseumWorkUrl": "https://id.rijksmuseum.nl/200111810",
      "objectNumber": "SK-A-4087",
      "recordNumber": 12038,
      "objectTypes": [
        "schilderij"
      ],
      "materials": [
        "doek",
        "olieverf"
      ],
      "description": "Gezicht op de koffieplantage Marienbosch aan de Commewijnerivier. Tussen twee groepen palmbomen en een waterwerk (loossluis) liggen aan de overzijde van een kanaal verschillende houten plantagegebouwen. Op een stenen vloer tussen de gebouwen verspreiden tot slaaf gemaakte mensen van Afrikaanse oorsprong koffiebonen zodat deze in de zon kunnen drogen. Naast koffie werd er ook katoen en cacao op Marienbosch verbouwd. Op het kanaal vaart een korjaal, een kleine vrachtboot. Op het pad langs het kanaal loopt een tot slaafgemaakte vrouw met kind en een man met hoed en wandelstok. Volgens het opschrift rechtsonder is het schilderij vervaardigd naar een tekening van A.L. Brockmann.$Gezicht op de koffieplantage Marienbosch aan de Commewijnerivier. Tussen twee groepen palmbomen en een waterwerk (loossluis) liggen aan de overzijde van een kanaal verschillende houten plantagegebouwen. Op een stenen vloer tussen de gebouwen verspreiden slaven koffiebonen zodat deze in de zon kunnen drogen. Naast koffie werd er ook katoen en cacao op Marienbosch verbouwd. Op het kanaal vaart een klein vrachtbootje. Op het pad langs het kanaal loopt een tot slaafgemaakte vrouw met kind en een man met hoed en wandelstok. Volgens het opschrift rechtsonder is het schilderij vervaardigd naar een tekening van A.L. Brockmann.$Gezicht op een koffieplantage in de tropen, wellicht 'Meerzorg' aan het Taparoepikanaal in Suriname? Op de voorgrond twee groepjes palmbomen, rechts een dijk met een scheprad. Links een kanaal met een bootje. Volgens het signatuur vervaardigd naar een tekening van A.L. Brockmann.",
      "license": "https://creativecommons.org/publicdomain/mark/1.0/",
