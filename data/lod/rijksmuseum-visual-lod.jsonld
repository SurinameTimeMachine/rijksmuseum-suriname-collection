    {
      "@id": "https://data.suriname-timemachine.org/source/rijksmuseum-rp-f-f01203",
      "@type": [
        "E22_Human_Made_Object"
      ],
      "sourceId": "rijksmuseum-rp-f-f01203",
      "prefLabel": "Fotoalbum van een onbekende Nederlandse familie met opnames van Suriname, Europa en Nederlands-Indië",
      "P2_has_type": "https://data.suriname-timemachine.org/type/source-type/visual-record",
      "P4_has_time_span": "https://data.suriname-timemachine.org/timespan/1910",
      "timeSpan": "1910",
      "maker": "diverse vervaardigers, anoniem, LeiBag",
      "holdingArchive": "Rijksmuseum, Amsterdam",
      "handleUrl": "https://www.rijksmuseum.nl/nl/collectie/RP-F-F01203",
      "sameAs": "https://id.rijksmuseum.nl/200322691",
      "rijksmuseumDataUrl": "https://data.rijksmuseum.nl/200322691",
      "rijksmuseumWorkUrl": "https://id.rijksmuseum.nl/200322691",
      "objectNumber": "RP-F-F01203",
      "recordNumber": 252429,
      "objectTypes": [
        "fotoalbum",
        "plakboek"
      ],
      "materials": [
        "linnen",
        "touw",
        "hout",
        "metaal",
        "karton",
        "papier",
        "fotodrager",
        "pergamijn"
      ],
      "description": "Fotoalbum in linnen omslag met kleurige geometrische patronen op voor- en achterplat. De bandrug is doorregen met een geel koord met een houten kraal aan het uiteinde. Het album heeft 24 door pergamijnvellen gescheiden kartonnen bladen. Daarop zijn 126 foto's geplakt, 3 foto's werden los in het album aangetroffen. Het album maakt deel uit van een serie van drie bij elkaar horende familiealbums: RP-F-F01202, RP-F-F01203 en RP-F-F01204. De meeste foto's in het onderhavige album hebben een handgeschreven, Nederlandstalig onderschrift en zijn doorgaans door amateurfotografen gemaakt.  In het album bevinden zich enkele afdrukken die identiek zijn aan die in album RP-F-F01202 en RP-F-F01204. Centrale figuur in het album is een onbekende vrouw die (vermoedelijk) ook de onderschriften maakte. Daarin verwijst zij regelmatig naar zichzelf, zoals bijvoorbeeld bij foto RP-F-F01203-CM \"hoe ik er uitzag in 1917\". Zij verbleef blijkens de foto's behalve in Nederland, ook in Suriname en in Nederlands-Indië waar zij deel uitmaakte van het koloniale establishment. In beeld zijn onder meer gebracht de opening van de Lawaspoorlijn (Landsspoorweg) in Paramaribo in 1905 en de onthulling van een standbeeld van koningin Wilhelmina op het Gouvernementsplein te Paramaribo in 1923. Voorts opnames van het huiselijke - en familieleven op de plantages ''t Vertrouwen', 'La liberté', en buitenplaats 'Veldlust' en van ontmoetingen, uitstapjes en reizen met vrienden en bekenden. De in de onderschriften genoemde namen zijn 'Terlaak', 'Janschen', 'Ottenhof', 'Carpentier en Dempsey', 'Friedel' en 'Mientje'.",
      "license": "https://creativecommons.org/publicdomain/mark/1.0/",
      "licenseLabel": "Public Domain",
      "copyrightHolder": null,
      "isPublicDomain": true,
      "wikidataUrl": null,
      "wikimediaUrl": "https://commons.wikimedia.org/wiki/File:Fotoalbum_van_een_onbekende_Nederlandse_familie_met_opnames_van_Suriname,_Europa_en_Nederlands-Indië,_RP-F-F01203.jpg",
      "linkedToGazetteer": false,
      "P128_carries": "https://data.suriname-timemachine.org/visual-item/rijksmuseum-rp-f-f01203-stm-00046",
      "wasDerivedFrom": "https://data.suriname-timemachine.org/provenance/rijksmuseum-sur-inventory"
    },
