      "prefLabel": "Hindostaans huwelijk: de dag van de Bhatwan",
      "P2_has_type": "https://data.suriname-timemachine.org/type/source-type/visual-record",
      "P4_has_time_span": "https://data.suriname-timemachine.org/timespan/1979",
      "timeSpan": "1979",
      "maker": "Bogaard, Hans van den",
      "holdingArchive": "Rijksmuseum, Amsterdam",
      "handleUrl": "https://www.rijksmuseum.nl/nl/collectie/NG-1979-566-20",
      "sameAs": "https://id.rijksmuseum.nl/200389384",
      "rijksmuseumDataUrl": "https://data.rijksmuseum.nl/200389384",
      "rijksmuseumWorkUrl": "https://id.rijksmuseum.nl/200389384",
