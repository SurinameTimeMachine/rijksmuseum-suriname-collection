    {
      "@id": "https://data.suriname-timemachine.org/source/rijksmuseum-ng-1979-566-29",
      "@type": [
        "E22_Human_Made_Object"
      ],
      "sourceId": "rijksmuseum-ng-1979-566-29",
      "prefLabel": "Surinaamse markt op dag der Vrijheden",
      "P2_has_type": "https://data.suriname-timemachine.org/type/source-type/visual-record",
      "P4_has_time_span": "https://data.suriname-timemachine.org/timespan/1977",
      "timeSpan": "1977",
      "maker": "Bogaard, Hans van den",
      "holdingArchive": "Rijksmuseum, Amsterdam",
      "handleUrl": "https://www.rijksmuseum.nl/nl/collectie/NG-1979-566-29",
      "sameAs": "https://id.rijksmuseum.nl/200389394",
      "rijksmuseumDataUrl": "https://data.rijksmuseum.nl/200389394",
      "rijksmuseumWorkUrl": "https://id.rijksmuseum.nl/200389394",
      "objectNumber": "NG-1979-566-29",
      "recordNumber": 329242,
      "objectTypes": [
        "documentaire foto"
      ],
      "materials": [
        "fotodrager"
      ],
      "description": "Op de Dag der Vrijheden 1977, de viering van de afschaffing van de slavernij in 1863, was er in Den Haag bij de Grote Markt een Surinaamse markt. Op de markt waren veel vrouwen te zien in traditionele kledij. Zo'n vrouw noemt men in Suriname een koto misi, wat rokdragende dame betekent. Het woord houdt verband met de Engelse woorden 'coat' en 'miss'. De koto is een gesteven rok die tot onder de oksels reikt, met daaronder vele onderrokken. Een opgevulde rol, de koi, laat de rok wijd uitstaan. De hoofddoek, de angisa, is kunstig tot een muts ineengespeld. Soms wordt een krant in de hoofddoek gestopt om hem te verstevigen.",
      "license": null,
      "licenseLabel": "Hans van den Bogaard",
      "copyrightHolder": null,
      "isPublicDomain": false,
      "wikidataUrl": null,
      "wikimediaUrl": null,
      "linkedToGazetteer": true,
