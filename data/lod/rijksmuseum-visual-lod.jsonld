      "prefLabel": "Gezicht op een plantage, mogelijk Rust en Werk.",
      "P2_has_type": "https://data.suriname-timemachine.org/type/source-type/visual-record",
      "P4_has_time_span": "https://data.suriname-timemachine.org/timespan/1849",
